node_modules/
dist/
release/
.DS_Store

# Signing material and credentials — never commit these
.env
.env.*
*.p12
*.pfx
*.pem
*.key
*.mobileprovision

# Secret registries and relay databases belong in an application-support or
# temporary directory, never beside the source. A harness that writes one here
# is a harness with the wrong path, and test/secure-sabotage.js fails the run
# if the repository root gains anything — this is only the second line of
# defence, so that a mistake cannot become a commit.
/secure-rooms.json
/relay.db
/relay.db-wal
/relay.db-shm

# Stamped by scripts/buildInfo.js at package time, read by electron/buildInfo.js
# at runtime. Generated, never committed — and ignored rather than merely
# untracked, so that stamping a build cannot make the tree it was built from
# report itself dirty.
/electron/build-info.json

# Local state written by MCP servers that are not Stacki (a Zulip client's
# cache, and whatever else gets pointed at this directory). Machine-local, and
# in at least one case a database of somebody's messages — never this repo's.
/.mcp/
