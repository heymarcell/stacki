  "build": {
    "appId": "com.stacki.editor",
    "productName": "Stacki",
    "afterPack": "./scripts/afterPack.js",
    "protocols": [
      {
        "name": "Stacki secure share invitation",
        "role": "Viewer",
        "schemes": [
          "stacki"
        ]
      }
    ],
    "files": [
      "electron/**/*",
      "dist/**/*",
      "scripts/fix-node-pty-permissions.js",
      "relay/protocol.js",
      "package.json",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "electron/astroParser.js",
      "electron/htmlText.js",
      "**/node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "flowtricks",
      "repo": "stacki-releases",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "resources/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "forceCodeSigning": true,
      "notarize": true
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
