{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stacki-secure-relay",
  "main": "src/worker.js",
  // Durable Objects with SQLite storage need a recent compatibility date; this
  // one is well past the 2024-04-03 that RPC methods require.
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // new_sqlite_classes, not new_classes: the room keeps its state in the
  // object's own SQLite database, which is what makes a cursor a WHERE clause.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],

  // The landing page is imported as text. A Worker has no filesystem to read
  // it from at runtime, and this keeps one copy of the page for both relays.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // Deliberate rather than default. `logs` keeps operational codes for a short
  // window; `head_sampling_rate` is 1 because the volume is tiny and a sampled
  // log of a rare failure is a log of nothing. Nothing that reaches this sink
  // carries a credential or a ciphertext — see the logging policy in
  // docs/secure-reviews-protocol.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }

  // Rate limiting for room creation is configured per deployment, because the
  // binding needs an account-level namespace id and everything here must run
  // locally without one. See README.md.
  //
  // "ratelimits": [
  //   { "name": "ROOM_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  // ]
}
